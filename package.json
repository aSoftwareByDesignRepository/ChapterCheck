{
  "name": "audioplayer",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop audiobook and music player for Linux (Tauri + React + mpv)",
  "keywords": [
    "audiobook",
    "audio-player",
    "linux",
    "tauri",
    "mpv",
    "chaptercheck"
  ],
  "author": "Alexander Mäule <info@software-by-design.de> (http://nextcloud.software-by-design.de)",
  "license": "MIT",
  "homepage": "https://github.com/aSoftwareByDesignRepository/ChapterCheck#readme",
  "bugs": {
    "url": "https://github.com/aSoftwareByDesignRepository/ChapterCheck/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aSoftwareByDesignRepository/ChapterCheck.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:mutate": "stryker run",
    "tauri": "tauri",
    "install:deb": "bash scripts/install-deb.sh",
    "ship": "npm run tauri build && npm run install:deb",
    "run:release": "src-tauri/target/release/audioplayer",
    "store:graphics": "python3 scripts/generate-store-graphics.py",
    "store:preflight": "bash scripts/store-preflight.sh",
    "store:privacy": "python3 scripts/publish-privacy-to-website.py",
    "store:flatpak-stage": "bash scripts/stage-flatpak-prefix.sh"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/outfit": "^5.2.8",
    "@tauri-apps/api": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.1",
    "vitest": "^3.2.4"
  }
}
